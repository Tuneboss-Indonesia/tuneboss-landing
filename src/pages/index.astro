---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { ParallaxComponent } from "../components/ui/parallax-scrolling";
import { TuneBossNavbar } from "../components/ui/resizable-navbar";
import TuneBossFeatures from "../components/ui/tuneboss-features";
import { DownloadCTA } from "../components/ui/download-cta";
import { StackedCircularFooter } from "../components/ui/stacked-circular-footer";
---

<Layout 
  title="TuneBoss ID | ECU Motor Berperforma Tinggi & Aksesori Racing" 
  description="Tingkatkan performa motor Anda dengan TuneBoss ECU. Belanja ECU motor, quickshifter, data logger, dan aksesori racing terbaik di Indonesia."
>
  <TuneBossNavbar lang="id" client:load />
  <ParallaxComponent lang="id" client:idle />
  <TuneBossFeatures lang="id" client:visible />
  <DownloadCTA lang="id" client:visible />
  <StackedCircularFooter lang="id" client:visible />
</Layout>
