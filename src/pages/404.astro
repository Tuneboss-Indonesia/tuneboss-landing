---
import { ErrorPage } from '../components/ui/error-page';
import { Image } from 'astro:assets';
import "../styles/global.css";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>404 - Tidak Ditemukan</title>
  </head>
  <body class="bg-background text-foreground antialiased">
    <ErrorPage code="404" description="Halaman yang Anda cari mungkin telah dipindah \n atau tidak ada." btnText="Kembali ke Beranda" btnLink="/">
      <Image src="/tuneboss-logo.png" alt="TuneBoss Logo" width={200} height={96} class="h-16 md:h-24 w-auto object-contain" loading="eager" />
    </ErrorPage>
  </body>
</html>
