---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { TuneBossNavbar } from "../components/ui/resizable-navbar";
import { StackedCircularFooter } from "../components/ui/stacked-circular-footer";
import { FramerCarousel } from "../components/ui/framer-carousel";
import { ProductCarousel } from "../components/ui/product-carousel";
import { HeroWithMarquee } from "../components/ui/cta-with-marquee";

const carouselItems = [
  { image: "/images/yamaha.webp", name: "Yamaha" },
  { image: "/images/honda.webp", name: "Honda" },
  { image: "/images/suzuki.webp", name: "Suzuki" },
  { image: "/images/kawasaki.webp", name: "Kawasaki" },
];
---

<Layout 
  title="Produk Kami | TuneBoss ECU & Aksesori" 
  description="Jelajahi koleksi lengkap produk TuneBoss ID mulai dari ECU stand-alone, modul quickshifter, hingga aksesori performa motor lainnya."
  lang="id"
>
  <TuneBossNavbar lang="id" client:load />
  
  <main class="min-h-[60vh] bg-black text-white flex flex-col items-center justify-start pb-20">
    <FramerCarousel client:load />

    <section class="w-full mt-10 py-20">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold font-sqr text-orange-matte mb-4 uppercase">
          Kendaraan yang Didukung
        </h2>
        <p class="text-lg text-neutral-400 max-w-2xl mx-auto mb-12">
          TuneBoss ECU mendukung berbagai model sepeda motor terkemuka.
        </p>
      </div>
      
      <ProductCarousel client:load items={carouselItems} options={{ loop: true, align: "center" }} />
    </section>

    <HeroWithMarquee client:visible />
  </main>

  <StackedCircularFooter lang="id" client:visible />
</Layout>
