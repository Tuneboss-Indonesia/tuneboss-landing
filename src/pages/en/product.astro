---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { TuneBossNavbar } from "../../components/ui/resizable-navbar";
import { StackedCircularFooter } from "../../components/ui/stacked-circular-footer";
import { FramerCarousel } from "../../components/ui/framer-carousel";
import { ProductCarousel } from "../../components/ui/product-carousel";
import { HeroWithMarquee } from "../../components/ui/cta-with-marquee";
import SpatialProductShowcase from "../../components/ui/spatial-product-showcase";

const carouselItems = [
  { image: "/images/yamaha.webp", name: "Yamaha" },
  { image: "/images/honda.webp", name: "Honda" },
  { image: "/images/suzuki.webp", name: "Suzuki" },
  { image: "/images/kawasaki.webp", name: "Kawasaki" },
];
---

<Layout 
  title="Our Products | TuneBoss ECU & Accessories" 
  description="Explore the complete collection of TuneBoss ID products, from stand-alone ECUs and quickshifter modules to other motorcycle performance accessories."
  lang="en"
>
  <TuneBossNavbar lang="en" client:load />
  
  <main class="min-h-[60vh] bg-black text-white flex flex-col items-center justify-start pb-20">
    <FramerCarousel client:idle />

    <section class="w-full mt-10 py-20">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold font-sqr text-orange-matte mb-4 uppercase">
          Supported Vehicles
        </h2>
        <p class="text-lg text-neutral-400 max-w-2xl mx-auto mb-12">
          TuneBoss ECU supports a wide range of leading motorcycle models.
        </p>
      </div>
      
      <ProductCarousel client:visible items={carouselItems} options={{ loop: true, align: "center" }} />
    </section>

    <section class="w-full pt-10">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold font-sqr text-white mb-4 uppercase">
          Featured <span class="text-orange-matte">Products</span>
        </h2>
        <p class="text-lg text-neutral-400 max-w-2xl mx-auto">
          Achieve maximum performance with the best product line from TuneBoss.
        </p>
      </div>
      
      <div>
        <SpatialProductShowcase lang="en" client:visible />
      </div>
    </section>

    <HeroWithMarquee lang="en" client:visible />
  </main>

  <StackedCircularFooter lang="en" client:visible />
</Layout>
