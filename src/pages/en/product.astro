---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { TuneBossNavbar } from "../../components/ui/resizable-navbar";
import { StackedCircularFooter } from "../../components/ui/stacked-circular-footer";
---

<Layout title="TuneBoss ID | Products" lang="en">
  <TuneBossNavbar lang="en" client:load />
  
  <main class="pt-20 min-h-[60vh] bg-black text-white flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold font-sqr text-[#e87a1e] mb-4">Our Products</h1>
      <p class="text-zinc-400">This page is currently under construction.</p>
    </div>
  </main>

  <StackedCircularFooter lang="en" client:visible />
</Layout>
