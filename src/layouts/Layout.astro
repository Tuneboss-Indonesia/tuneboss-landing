---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TuneBoss ID - ECU & Motorcycle Tuning",
  description = "Marketplace produk ECU motor, tuning performa, quickshifter, data logger, dan aksesori racing TuneBoss Indonesia.",
} = Astro.props;
---

<!doctype html>
<html lang="id" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e63946" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Preload fonts -->
    <link rel="preload" href="/fonts/Futura-PT-Book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Futura-PT-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SQR721BE.woff2" as="font" type="font/woff2" crossorigin />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-image.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
